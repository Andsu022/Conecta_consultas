# Conecta Consultas - Arquivos ignorados pelo Git

# Ambientes Virtuais (Python Virtual Environments)
venv/
.venv/
env/
backend/venv/
backend/.venv/

# Caches e arquivos compilados do Python
__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/
.coverage
.coverage.*
htmlcov/

# Bancos de dados e dados locais (SQLite e arquivos de transação/WAL)
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
*.sqlite-journal
backend/*.db
backend/database/*.db
backend/database/*.db-journal
backend/database/*.db-wal
backend/database/*.db-shm

# Chaves de segurança, senhas e variáveis de ambiente
.env
.env.*
!.env.example
*.pem
*.pub
id_rsa*

# Logs e arquivos de depuração
*.log
logs/

# Arquivos de IDEs e Editores de Código
.idea/
.vscode/
*.swp
*.swo

# Arquivos do Sistema Operacional
.DS_Store
Thumbs.db
desktop.ini

# Arquivos de anotações e temporários
annotations.txt
*.bak
*.tmp